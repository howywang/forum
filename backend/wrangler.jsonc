{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petlens-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "FRONTEND_BASE_URL": "https://howywang.github.io/forum",
    "RESEND_FROM_EMAIL": "PetTalk <onboarding@resend.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petlens-db",
      "database_id": "2a488e02-f484-4090-96d0-da56bbcc5637"
    }
  ]
}
